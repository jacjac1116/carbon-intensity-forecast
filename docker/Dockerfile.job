# Pinned by digest so every build starts from exactly the same image.
FROM python:3.11.18-slim-trixie@sha256:65bd3d9f1d7fa268dd1909973ba7eb4bdf41f6dcf2cfbe76ba9528b170f3fd79

# A normal user to run the job, 
# since it doesn't need root (switched to at the end).
RUN useradd --create-home app

# Set working directory inside the container
WORKDIR /app

# Install system-level dependencies required by LightGBM.
# libgomp1 provides the GNU OpenMP runtime, which LightGBM uses
# for parallel processing.
# --no-install-recommends avoids installing unnecessary packages.
# Removing apt lists afterwards reduces the final image size.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Dependencies first, so a code change doesn't rerun this install.
# --require-hashes refuses any file that doesn't match the lock.
COPY requirements.lock .
RUN pip install --no-cache-dir --require-hashes -r requirements.lock

# Only the lock decides what gets installed: --no-deps installs just this package,
# and pip check fails the build if the lock is missing something it needs.
COPY pyproject.toml .
COPY src/ src/
RUN pip install --no-cache-dir --no-deps . && pip check

COPY outputs/models outputs/models
COPY scripts/ scripts/
COPY configs/ configs/
COPY outputs/schemas outputs/schemas 
# ^ ^ 
# | └── destination: /app/outputs/ inside the container 
# └── source: outputs/ from your project folder

# Define environment variables
ENV MODEL_DIR=/app/outputs/models
ENV CONFIGS_PATH=/app/configs/model/lgbm_24h.yaml
ENV SCHEMAS_PATH=/app/outputs/schemas/latest_schema.json
ENV FORECAST_TABLE_ID=gen-lang-client-0232862267.carbon_forecast.predictions
ENV ACTUALS_TABLE_ID=gen-lang-client-0232862267.carbon_forecast.actuals
ENV GCP_PROJECT=gen-lang-client-0232862267

# Prevent Python from generating __pycache__ and .pyc files.
ENV PYTHONDONTWRITEBYTECODE=1

USER app

# Run action
ENTRYPOINT ["python", "scripts/run_daily_prediction.py"]